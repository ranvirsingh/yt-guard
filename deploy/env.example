# Copy to deploy/.env (git-ignored) and fill in.
TV_IP=192.168.1.50                 # current TV address; also supplies the default /24 discovery network
KUBECONFIG=~/.kube/config          # kubeconfig for the cluster
# DISCOVERY_CIDR=192.168.1.0/24     # optional override; at most 256 addresses
# DISCOVERY_INTERVAL=60             # seconds between scans while the TV address is stale
# KEYWORDS=minecraft,roblox,fortnite  # seed list, used only until the UI saves rules
# DEVICE_NAME=YT Guard                # name shown on the TV's linked devices
# LOG_LEVEL=INFO
